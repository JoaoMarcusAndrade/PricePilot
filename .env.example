# Copie este arquivo para .env e preencha os valores reais.

# Chave da API da OpenAI (ou de um endpoint compatível).
OPENAI_API_KEY=

# Modelo usado pelo assistente.
OPENAI_MODEL=gpt-4o-mini

# Opcional: use apenas se a key apontar para um endpoint compatível com a
# OpenAI que não seja https://api.openai.com/v1.
OPENAI_BASE_URL=

# Limite de caracteres de uma mensagem do chat.
CHAT_MAX_MESSAGE_LENGTH=500

# Máximo de requisições por minuto por IP no /api/chat.
CHAT_MAX_REQUESTS_PER_MINUTE=10